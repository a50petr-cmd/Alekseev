# OAuth-токен с правами чтения Яндекс Вебмастера и Яндекс Метрики.
YANDEX_OAUTH_TOKEN=

# Адрес сайта в Яндекс Вебмастере. Скрипт сам найдёт host_id.
YANDEX_SITE_URL=https://petr-alekseev.ru/

# Номер счётчика Яндекс Метрики.
YANDEX_METRIKA_COUNTER_ID=113335579

# Telegram-бот для еженедельного SEO-отчёта. Не коммитить.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# JSON-ключ сервисного аккаунта Google (Search Console и GA4). Файл ключа не коммитить.
GOOGLE_SA_KEY_PATH=
