ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# https и без www (без цикла на Reg.ru: HTTPS может быть off за прокси)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://petr-alekseev.ru%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://petr-alekseev.ru%{REQUEST_URI} [R=301,L]

# Корень: /index.html → /
RewriteRule ^index\.html$ / [R=301,L]

# Старые URL блога → новый индекс
RewriteRule ^blog/franchise\.html$ /blog/ [R=301,L]
RewriteRule ^blog/import\.html$ /blog/ [R=301,L]
RewriteRule ^blog/kpi\.html$ /blog/ [R=301,L]
RewriteRule ^blog/logistics\.html$ /blog/ [R=301,L]
RewriteRule ^blog/index\.html$ /blog/ [R=301,L]

# Данные админки / счётчиков — не отдавать
RewriteRule ^petr-alekseev-data(/|$) - [F,L]

# Старый URL админки (Reg.ru часто режет /admin/) → новый
RewriteRule ^admin(/.*)?$ /publish$1 [R=302,L]

# Все статьи блога через PHP (скрытие удалённых из админки + динамические)
RewriteRule ^blog/([a-z0-9-]+)\.html$ /blog/article.php?slug=$1 [L,QSA]

# Старые страницы → новые (301)
RewriteRule ^services\.html$ /#offers [R=301,L,NE]
RewriteRule ^cases\.html$ /#cases [R=301,L,NE]
RewriteRule ^about\.html$ /#about [R=301,L,NE]
RewriteRule ^contacts\.html$ /#contact [R=301,L,NE]
RewriteRule ^dark-store\.html$ /operations-director.html [R=301,L]
RewriteRule ^franchise\.html$ / [R=301,L]
RewriteRule ^materials\.html$ /blog/ [R=301,L]
RewriteRule ^checklists/(franchise|import|kpi|logistics)\.html$ /blog/ [R=301,L]
</IfModule>

# Закрыть служебные файлы (robots.txt и blog/posts.json доступны)
<IfModule mod_authz_core.c>
  <FilesMatch "\.(md|mjs|json|txt|bundle|example)$">
    Require all denied
  </FilesMatch>
  <Files "robots.txt">
    Require all granted
  </Files>
  <Files "15cc1411bc624812835571494ad154e0.txt">
    Require all granted
  </Files>
  <Files "posts.json">
    Require all granted
  </Files>
</IfModule>

# Заголовки безопасности
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # X-Frame-Options не умеет allowlist и перекрывает CSP. Карты Метрики/Вебвизор — только frame-ancestors.
  Header set Content-Security-Policy "frame-ancestors 'self' https://metrika.yandex.ru https://analytics.yandex.by https://analytics.yandex.com https://analytics.yandex.com.tr https://analytics.yandex.kz https://analytics.yandex.ru https://metr.yandex.by https://metr.yandex.com https://metr.yandex.com.tr https://metr.yandex.kz https://metr.yandex.ru https://metrica.ya.ru https://metrica.yandex https://metrica.yandex.by https://metrica.yandex.com https://metrica.yandex.com.tr https://metrica.yandex.kz https://metrica.yandex.ru https://metrika.ya.ru https://metrika.yandex https://metrika.yandex.by https://metrika.yandex.com https://metrika.yandex.com.tr https://metrika.yandex.kz https://metrika.yandex.uz https://webvisor.com https://*.webvisor.com"
</IfModule>

# Кеш
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
</IfModule>

# Явный Cache-Control: хостинг иногда ставит max-age на недели вперёд
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/json
</IfModule>
